<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <input>
    <net-file value="../../../network/bengaluru.net.xml"/>
    <additional-files value="stops.add.xml,buses.rou.xml,../../../routes/demand.rou.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="1500"/>
  </time>
  <processing>
    <collision.action value="warn"/>
  </processing>
  <report>
    <no-step-log value="true"/>
  </report>
</configuration>
